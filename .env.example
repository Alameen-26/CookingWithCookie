# Copy this file to .env and fill in your values. Never commit .env.
# Without OPENAI_API_KEY the chatbot uses its built-in rule-based replies.
OPENAI_API_KEY=
# Optional: model name (default gpt-6-luna)
OPENAI_MODEL=
# Optional: any OpenAI-compatible API endpoint
OPENAI_BASE_URL=
# Optional: web search so Ask Cookie can ground general cooking, recipe and
# nutrition answers in online sources and cite links. Only used when
# OPENAI_API_KEY is also set. Leave SEARCH_API_KEY empty to turn it off.
# SEARCH_PROVIDER: tavily (default, https://tavily.com) or brave
# (https://brave.com/search/api/).
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# Optional: seconds to wait for search before answering without it (default 6)
SEARCH_TIMEOUT_SECONDS=6
# Show prices on the site, in /api/menu, /api/quote and the chatbot.
# Keep false until pricing is finalized.
SHOW_PRICES=false
# Contact details the chatbot gives only for pickup and bulk orders
CONTACT_EMAIL=alajiadeniyi@gmail.com
CONTACT_PHONE=(902) 495-1781
# Optional: max chat messages per visitor IP per minute (default 10)
CHAT_RATE_LIMIT_PER_MINUTE=10
# Optional: set to 1 for Flask debug mode (local development only)
FLASK_DEBUG=0
